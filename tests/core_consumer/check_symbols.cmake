foreach(binary IN ITEMS "${CORE}" "${CONSUMER}")
    execute_process(COMMAND "${NM}" -C "${binary}" RESULT_VARIABLE result
        OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${binary}: ${error}")
    endif()
    if(DEFINED USE_OPENMP AND NOT USE_OPENMP AND symbols MATCHES "[ \t](GOMP_|omp_|__kmpc_)[A-Za-z_]")
        message(FATAL_ERROR "OpenMP runtime symbol in disabled build: ${binary}")
    endif()
    # Check definitions AND unresolved references in the archive, plus the linked consumer.
    if(symbols MATCHES "rabitqlib::(ivf|hnsw|symqg|qgkmeans|rabitqkmeans)::|hnswlib::")
        message(FATAL_ERROR "ANN symbols in ${binary}")
    endif()
    if(binary STREQUAL CORE OR COMPONENT STREQUAL "core")
        if(symbols MATCHES "rabitqlib::fastscan::(simd::)?(accumulate|pack_lut|transfer_lut)|rabitqlib::simd::(qg_batch_estdist|split_batch_estdist)")
            message(FATAL_ERROR "FastScan scoring symbols in core: ${binary}")
        endif()
    endif()
endforeach()
